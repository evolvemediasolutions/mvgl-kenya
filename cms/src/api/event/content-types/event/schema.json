{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Expos, trade fairs, conferences, and technical events for MVGL Kenya"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "eventType": {
      "type": "enumeration",
      "enum": [
        "Industrial Expo",
        "Trade Exhibition",
        "Technical Conference",
        "Webinar & Workshop"
      ],
      "default": "Industrial Expo"
    },
    "dateDisplay": {
      "type": "string"
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "location": {
      "type": "string",
      "required": true
    },
    "boothNumber": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "registrationUrl": {
      "type": "string"
    },
    "eventStatus": {
      "type": "enumeration",
      "enum": [
        "Upcoming",
        "Ongoing",
        "Completed"
      ],
      "default": "Upcoming"
    }
  }
}
