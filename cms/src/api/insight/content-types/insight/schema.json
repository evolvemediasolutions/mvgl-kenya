{
  "kind": "collectionType",
  "collectionName": "insights",
  "info": {
    "singularName": "insight",
    "pluralName": "insights",
    "displayName": "Insight",
    "description": "Articles, technical briefs, case studies, and engineering perspectives for MVGL Kenya"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false
    },
    "category": {
      "type": "string",
      "required": true,
      "default": "Technical Insights"
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "author": {
      "type": "string",
      "default": "MVGL Kenya Editorial"
    },
    "readTime": {
      "type": "string",
      "default": "5 min read"
    },
    "publishedDate": {
      "type": "string"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    }
  }
}
