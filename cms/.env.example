# ===================================================
# STRAPI CMS PRODUCTION ENVIRONMENT VARIABLES
# ===================================================

# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Application Secrets (Render generates these automatically if using render.yaml)
APP_KEYS=generate_random_key_1,generate_random_key_2
API_TOKEN_SALT=generate_random_salt_1
ADMIN_JWT_SECRET=generate_random_secret_1
JWT_SECRET=generate_random_secret_2
TRANSFER_TOKEN_SALT=generate_random_salt_2
ENCRYPTION_KEY=generate_random_key_3

# Database (PostgreSQL on Render / Railway / Supabase)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@host:5432/database_name
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Public URL (Optional: your live Render URL)
# PUBLIC_URL=https://mvgl-cms.onrender.com

# Cloudinary Media Storage (Free 25 GB permanent cloud CDN for images & PDFs)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
